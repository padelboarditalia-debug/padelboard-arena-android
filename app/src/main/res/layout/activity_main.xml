<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PadelBoard Arena"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanner fermo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:id="@+id/phaseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partita pronta"
            android:textSize="17sp"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avvia rilevamento Shelly" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LATO A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/scoreAText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GAME"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/gamesAText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/assignAButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Associa pulsante A" />

                <TextView
                    android:id="@+id/deviceAText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non associato"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LATO B"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/scoreBText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GAME"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/gamesBText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/assignBButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Associa pulsante B" />

                <TextView
                    android:id="@+id/deviceBText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non associato"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/eventText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ultimo evento: —"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <Button
            android:id="@+id/resetScoreButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Azzera partita" />

        <Button
            android:id="@+id/resetDevicesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancella associazioni pulsanti" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pressione singola: assegna il punto&#10;Doppia pressione: annulla l’ultima azione&#10;40-40 → ADV → parità → KILLER"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="18dp" />

    </LinearLayout>

</ScrollView>