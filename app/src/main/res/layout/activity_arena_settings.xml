<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/arenaSettingsTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Impostazioni Arena"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="18dp" />

    <EditText
        android:id="@+id/arenaSettingsPasswordEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password E2E"
        android:inputType="textPassword"
        android:singleLine="true" />

    <Button
        android:id="@+id/arenaSettingsLoginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login Arena" />

    <TextView
        android:id="@+id/arenaSettingsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login Arena richiesto"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingTop="12dp" />

    <Button
        android:id="@+id/arenaSettingsBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Torna" />

</LinearLayout>
